{
  "name": "frasberg-carjack",
  "version": "1.0.0",
  "description": "Frasberg Carjack — Professional open-world carjacking game by FRASBERG INC.",
  "author": "Frasberg Selassie <frasberg@frasberginc.com>",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev":            "vite",
    "build":          "vite build",
    "preview":        "vite preview",
    "server":         "node server/multiplayer.js",
    "electron":       "NODE_ENV=development electron .",
    "electron:build": "npm run build && electron-builder",
    "mobile:start":   "cd mobile && npx expo start",
    "mobile:android": "cd mobile && npx expo run:android",
    "mobile:ios":     "cd mobile && npx expo run:ios",
    "docker:up":      "docker-compose up -d",
    "docker:down":    "docker-compose down",
    "docker:logs":    "docker-compose logs -f",
    "lint":           "eslint src --ext .js",
    "test":           "vitest run",
    "deploy":         "bash infra/deploy.sh"
  },
  "dependencies": {
    "ws":                "^8.16.0",
    "uuid":              "^9.0.0",
    "ioredis":           "^5.3.2",
    "redis":             "^4.6.10",
    "jsonwebtoken":      "^9.0.2",
    "bcryptjs":          "^2.4.3",
    "dotenv":            "^16.4.5",
    "express":           "^4.19.2",
    "cors":              "^2.8.5",
    "helmet":            "^7.1.0",
    "rate-limiter-flexible": "^5.0.3",
    "prom-client":       "^15.1.2"
  },
  "devDependencies": {
    "vite":              "^5.2.0",
    "eslint":            "^9.0.0",
    "vitest":            "^1.5.0",
    "electron":          "^30.0.0",
    "electron-builder":  "^24.13.0",
    "electron-updater":  "^6.1.8",
    "electron-store":    "^10.0.0",
    "nodemon":           "^3.0.2"
  },
  "build": {
    "appId":       "com.frasberginc.carjack",
    "productName": "Frasberg Carjack",
    "directories": { "output": "release" },
    "files":       ["dist/**/*", "electron/**/*", "server/**/*", "assets/**/*"],
    "win":  { "target": "nsis",    "icon": "assets/icon.ico" },
    "mac":  { "target": "dmg",     "icon": "assets/icon.icns" },
    "linux":{ "target": "AppImage","icon": "assets/icon.png" }
  }
}
