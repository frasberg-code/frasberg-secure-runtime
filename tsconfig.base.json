{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "declaration": true,
    "rootDir": "./",
    "baseUrl": ".",
    "paths": {
      "@frasberg/shared": ["packages/shared/src/index.ts"],
      "@frasberg/full-game-stack-schema": ["packages/full-game-stack-schema/src/index.ts"],
      "@frasberg/worldgraph-engine": ["packages/worldgraph-engine/src/index.ts"],
      "@frasberg/builder-v2-orchestrator": ["packages/builder-v2-orchestrator/src/index.ts"]
    },
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  }
}
